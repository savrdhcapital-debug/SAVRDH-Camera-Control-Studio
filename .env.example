# Canon EOS R50 CCAPI address (camera's IP on your Wi-Fi network)
CCAPI_BASE_URL=http://192.168.1.10:8080
# Set to "true" to run without a camera (simulated EOS R50)
NEXT_PUBLIC_MOCK_MODE=true

# Camera Studio database (server only; separate from TV OS records)
CAMERA_SUPABASE_URL=https://ldfbrwcdebwoypthdqko.supabase.co
CAMERA_SUPABASE_SERVICE_ROLE_KEY=
# Explicit hosted admin origin, no trailing slash
CAMERA_ADMIN_ORIGIN=https://camera-control-studio.vercel.app
# SHA-256 of your private admin access key (64 lowercase hex characters)
CAMERA_ADMIN_KEY_HASH=
# Random secret with at least 32 characters for encrypted sessions
CAMERA_ADMIN_SESSION_SECRET=
